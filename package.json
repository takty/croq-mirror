{
	"name": "croq-mirror",
	"version": "0.1.0",
	"description": "CodeMirror 6 based editor component extracted from Croqujs",
	"license": "MIT",
	"private": true,
	"type": "module",
	"exports": {
		".": "./dist/croq-mirror.min.js",
		"./structure": "./dist/structure-view.js",
		"./function-line-numbers": "./dist/function-line-numbers.js",
		"./gutter-line-selection": "./dist/gutter-line-selection.js",
		"./indent-rulers": "./dist/indent-rulers.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "node build.mjs && vite build",
		"docs": "node build.mjs && vite build",
		"dev": "node build.mjs && vite",
		"preview": "vite preview",
		"test": "node build.mjs && node --test test/*.test.mjs",
		"test:browser": "node build.mjs && vite build && node test/headless.mjs"
	},
	"dependencies": {
		"@codemirror/autocomplete": "6.20.1",
		"@codemirror/commands": "6.10.3",
		"@codemirror/lang-javascript": "6.2.5",
		"@codemirror/language": "6.12.3",
		"@codemirror/lint": "6.9.5",
		"@codemirror/search": "6.6.0",
		"@codemirror/state": "6.6.0",
		"@codemirror/view": "6.41.0",
		"@lezer/highlight": "1.2.3",
		"acorn": "8.19.0",
		"acorn-loose": "8.5.2",
		"acorn-walk": "8.3.5",
		"js-beautify": "2.0.3",
		"jshint": "2.13.6",
		"jshint-ja-edu": "github:takty/jshint-ja-edu",
		"tern": "0.24.3"
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"klales": "github:takty/klales",
		"vite": "^8.3.5"
	},
	"packageManager": "yarn@4.18.0"
}
